\newcommand{\placeholderfigure}[2][0.78\linewidth]{%
\begin{figure}[H]\centering
\fbox{\begin{minipage}[c][4.1cm][c]{#1}\centering
\textcolor{TodoRed}{\bfseries [CHƯA CÓ HÌNH]}\\[0.5em]
#2
\end{minipage}}
\caption{#2}\label{fig:placeholder-\thefigure}
\end{figure}}

\newcommand{\safeimage}[3][0.82\linewidth]{%
\begin{figure}[H]\centering
\IfFileExists{../../assets/#2}{\includegraphics[width=#1]{../../assets/#2}}{%
\fbox{\begin{minipage}[c][4.1cm][c]{#1}\centering\textcolor{TodoRed}{\bfseries [CHƯA CÓ FILE: \texttt{\detokenize{#2}}]}\\[0.5em]#3\end{minipage}}}
\caption{#3}\end{figure}}

